{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:public": "next dev -H 127.0.0.1 -p 38100",
    "dev:admin": "tsx watch server/admin/main.ts",
    "dev:worker": "node --env-file-if-exists=.env.local --import tsx --watch server/worker/main.ts",
    "dev": "concurrently -k \"npm:dev:public\" \"npm:dev:admin\" \"npm:dev:worker\"",
    "build:public": "next build",
    "build:admin": "vite build --config admin/vite.config.ts",
    "build": "npm run build:public && npm run build:admin",
    "build:bundles": "tsup --config tsup.config.ts",
    "build:release": "npm run build && npm run build:bundles",
    "start:public": "tsx scripts/start-public.ts",
    "start:admin": "tsx server/admin/main.ts",
    "start:worker": "node --env-file-if-exists=.env.local --import tsx server/worker/main.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "package:release": "npm run build:release && tsx scripts/package-release.ts",
    "backup": "tsx scripts/backup.ts",
    "restore:check": "tsx scripts/restore-check.ts",
    "secrets": "tsx scripts/set-secret.ts",
    "configure-local": "tsx scripts/configure-local.ts",
    "keychain:doctor": "tsx scripts/keychain-doctor.ts",
    "launch-agents": "tsx scripts/install-launch-agents.ts",
    "line:rich-menu": "tsx scripts/provision-line-rich-menu.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "ops:doctor": "tsx scripts/ops-doctor.ts",
    "preview:sites": "vinext dev",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@line/liff": "^2.30.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.5",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.34.5",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^10.0.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "vitest": "^4.1.11",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
